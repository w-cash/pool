network = "testnet"
deployment_id = "@DEPLOYMENT_ID@"
pool_instance = "@POOL_INSTANCE@"
backend_instance = "@BACKEND_INSTANCE@"
journal_stream = "@JOURNAL_STREAM@"
chain_id = @WCASH_CHAIN_ID@
wcash_genesis = "@WCASH_GENESIS_WIRE@"
zcash_genesis = "@ZCASH_GENESIS_WIRE@"
wcash_payout_commitment = "@WCASH_PAYOUT_COMMITMENT_WIRE@"
zcash_payout_commitment = "@ZCASH_PAYOUT_COMMITMENT_WIRE@"
backend_socket = "@BACKEND_SOCKET@"
database_url_file = "@DATABASE_URL_RUNTIME_PATH@"
stratum_listen = "@STRATUM_LISTEN@"
portal_listen = "@PORTAL_LISTEN@"
portal_origin = "@PORTAL_ORIGIN@"
payout_change_hold_secs = @PAYOUT_CHANGE_HOLD_SECS@
nonce_namespace = @NONCE_NAMESPACE@
nonce_reservation = @NONCE_RESERVATION@
database_connections = @DATABASE_CONNECTIONS@
maximum_miners = @MAXIMUM_MINERS@
maximum_miners_per_ip = @MAXIMUM_MINERS_PER_IP@
authentication_parallelism = @AUTHENTICATION_PARALLELISM@
wcash_wallet_program = "@WCASH_RELEASE_ROOT@/wcash-wallet"
wcash_wallet_sha256 = "@WCASH_WALLET_SHA256@"
wcash_wallet_uid = 0
payout_mode = "deferred"
wcash_node_rpc = "@WCASH_NODE_RPC@"
wcash_node_cookie_file = "@WCASH_COOKIE_RUNTIME_PATH@"
zcash_node_rpc = "@ZCASH_NODE_RPC@"
zcash_node_cookie_file = "@ZCASH_COOKIE_RUNTIME_PATH@"
portal_token_pepper_file = "@PORTAL_PEPPER_RUNTIME_PATH@"
portal_totp_key_file = "@PORTAL_TOTP_RUNTIME_PATH@"
initial_share_target_be = "@INITIAL_SHARE_TARGET_BE@"
easiest_share_target_be = "@EASIEST_SHARE_TARGET_BE@"

[wcash_policy]
pplns_window_work = "@WEC_PPLNS_WINDOW_WORK@"
payout_threshold_zat = @WEC_PAYOUT_THRESHOLD_ZAT@
required_confirmations = @WEC_REQUIRED_CONFIRMATIONS@
maximum_payout_outputs = @WEC_MAXIMUM_PAYOUT_OUTPUTS@
maximum_payout_zat = @WEC_MAXIMUM_PAYOUT_ZAT@
maximum_network_fee_zat = @WEC_MAXIMUM_NETWORK_FEE_ZAT@
maximum_network_fee_bps = @WEC_MAXIMUM_NETWORK_FEE_BPS@
policy_version = @WEC_POLICY_VERSION@

[zcash_policy]
pplns_window_work = "@ZEC_PPLNS_WINDOW_WORK@"
payout_threshold_zat = @ZEC_PAYOUT_THRESHOLD_ZAT@
required_confirmations = @ZEC_REQUIRED_CONFIRMATIONS@
maximum_payout_outputs = @ZEC_MAXIMUM_PAYOUT_OUTPUTS@
maximum_payout_zat = @ZEC_MAXIMUM_PAYOUT_ZAT@
maximum_network_fee_zat = @ZEC_MAXIMUM_NETWORK_FEE_ZAT@
maximum_network_fee_bps = @ZEC_MAXIMUM_NETWORK_FEE_BPS@
policy_version = @ZEC_POLICY_VERSION@

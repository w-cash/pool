# Copy to /etc/wcash-pool/deployment.env, set mode 0600, and replace every
# CHANGE_ME value. This file contains identifiers and paths, never key material.

DEPLOYMENT_ID=CHANGE_ME_UUID
POOL_INSTANCE=CHANGE_ME_UUID
# These identify fresh dedicated collector accounts whose balances must be
# exactly zero before backend initialization. The discovery sentinel is valid
# only for the wallet-bootstrap render. Replace it with the reviewed canonical
# UUID returned by each reviewed wallet before running bootstrap or finalize.
WCASH_SIGNER_ACCOUNT=BOOTSTRAP_DISCOVERY_REQUIRED
ZCASH_SIGNER_ACCOUNT=BOOTSTRAP_DISCOVERY_REQUIRED

# Wcash AuxPoW chain identifier. Keep decimal and hexadecimal operator records.
WCASH_CHAIN_ID=1464025427

# Display order is used by node RPC and the Wolf backend environment. Wire
# order is the exact byte reversal used by wcash-poold. The renderer proves the
# relationship and refuses a mismatch.
WCASH_GENESIS_DISPLAY=CHANGE_ME_64_HEX
WCASH_GENESIS_WIRE=CHANGE_ME_64_HEX
ZCASH_GENESIS_DISPLAY=CHANGE_ME_64_HEX
ZCASH_GENESIS_WIRE=CHANGE_ME_64_HEX

# Exact raw commitments derived from the initialized payout wallets and
# independently rechecked by native code. The discovery sentinel is never
# accepted into backend or pool runtime policy.
WCASH_PAYOUT_COMMITMENT_WIRE=BOOTSTRAP_DISCOVERY_REQUIRED
ZCASH_PAYOUT_COMMITMENT_WIRE=BOOTSTRAP_DISCOVERY_REQUIRED
# The launch collector is private Ironwood only. There is deliberately no
# transparent fallback: both payout wallets must attest these commitments.
WCASH_PAYOUT_MODE=ironwood

# Big-endian share targets. The easiest target is an immutable safety ceiling.
INITIAL_SHARE_TARGET_BE=CHANGE_ME_64_HEX
EASIEST_SHARE_TARGET_BE=CHANGE_ME_64_HEX

APEX_HOST=zecwec.com
PORTAL_HOST=testnet.zecwec.com
MINING_HOST=testnet-mine.zecwec.com
PORTAL_ORIGIN=https://testnet.zecwec.com
PORTAL_LISTEN=127.0.0.1:8080
STRATUM_LISTEN=0.0.0.0:3333
STRATUM_TLS_PORT=3443
LEGACY_STRATUM_PORT=28237

# Node and wallet endpoints are loopback-only. Never put remote credentials in
# these URLs; systemd credentials supply authentication separately.
WCASH_RPC_URL=http://127.0.0.1:38232
WCASH_NODE_RPC=127.0.0.1:38232
ZCASH_TEMPLATE_RPC_URL=http://127.0.0.1:18232
ZCASH_VALIDATOR_RPC_URL=http://127.0.0.1:18242
WCASH_LIGHTWALLETD_ENDPOINT=http://127.0.0.1:38234
WCASH_LIGHTWALLETD_UNIT=wcash-peer-testnet.service
ZALLET_RPC=127.0.0.1:28232
ZCASH_NODE_RPC=127.0.0.1:18242

# Existing service names and protected server-side cookie locations.
WCASH_NODE_UNIT=wcash-testnet-node.service
ZCASH_TEMPLATE_UNIT=zcash-template-testnet.service
ZCASH_VALIDATOR_UNIT=zcash-validator-testnet.service
WCASH_RPC_COOKIE_SOURCE=/run/wcash-node-rpc/.cookie
ZCASH_TEMPLATE_COOKIE_SOURCE=/run/zcash-template-rpc/.cookie
ZCASH_VALIDATOR_COOKIE_SOURCE=/run/zcash-validator-rpc/.cookie

# Persistent locations. Do not point any of these at /tmp or a user's home.
POOL_STATE_DIR=/var/lib/wcash-pool
BACKEND_STATE_DIR=/var/lib/wcash-pool-backend
BACKEND_RUNTIME_DIR=/run/wcash-pool-backend
BACKEND_SOCKET=/run/wcash-pool-backend/backend.sock
WEC_SEED_FILE=/var/lib/wcash-pool-secrets/wcash-seed
ZALLET_STATE_DIR=/var/lib/zecwec-zallet
ZALLET_CONFIG_FILE=/etc/wcash-pool/zallet.toml
WCASH_WALLET_DATABASE=/var/lib/wcash-pool/wcash-wallet.sqlite
# Height 1 scans the complete post-genesis history. Height 0 is not a valid
# wallet birthday because the birthday tree state is taken from the prior block.
WCASH_WALLET_BIRTHDAY=1
WCASH_WALLET_SYNC_BATCH_SIZE=16
WCASH_WALLET_SYNC_TIMEOUT_SECONDS=900
WEC_SIGNER_JOURNAL=/var/lib/wcash-pool/wec-payout-journal
ZEC_SIGNER_JOURNAL=/var/lib/wcash-pool/zec-payout-journal

# Source credential files are copied by systemd into private per-unit mounts.
WCASH_PAYOUT_ADDRESS_CREDENTIAL=/etc/wcash-pool/credentials/wcash-payout-address
WCASH_PAYOUT_IVK_CREDENTIAL=/etc/wcash-pool/credentials/wcash-payout-ivk
ZCASH_PAYOUT_ADDRESS_CREDENTIAL=/etc/wcash-pool/credentials/zcash-payout-address
PORTAL_TOKEN_PEPPER_CREDENTIAL=/etc/wcash-pool/credentials/portal-token-pepper
PORTAL_TOTP_KEY_CREDENTIAL=/etc/wcash-pool/credentials/portal-totp-key
DATABASE_MIGRATOR_URL_CREDENTIAL=/etc/wcash-pool/credentials/database-url-migrator
DATABASE_RUNTIME_URL_CREDENTIAL=/etc/wcash-pool/credentials/database-url-runtime

POSTGRES_DATABASE=zecwec_pool_testnet
POSTGRES_MIGRATOR_ROLE=zecwec_pool_migrator
POSTGRES_RUNTIME_ROLE=zecwec_pool_runtime

NONCE_NAMESPACE=1
NONCE_RESERVATION=65536
DATABASE_CONNECTIONS=8
MAXIMUM_MINERS=1024
# TLS clients arrive at wcash-poold through nginx loopback. nginx separately
# enforces a real-source limit, while this ceiling prevents proxy collapse.
MAXIMUM_MINERS_PER_IP=1024
AUTHENTICATION_PARALLELISM=4
BACKEND_LISTENERS=2
WCASH_VALIDATION_LIMIT=4

WEC_PPLNS_WINDOW_WORK=1000000
WEC_PAYOUT_THRESHOLD_ZAT=100000000
WEC_REQUIRED_CONFIRMATIONS=100
WEC_MAXIMUM_PAYOUT_OUTPUTS=50
WEC_MAXIMUM_NETWORK_FEE_ZAT=1000000
WEC_MAXIMUM_NETWORK_FEE_BPS=100
WEC_POLICY_VERSION=1

ZEC_PPLNS_WINDOW_WORK=1000000
ZEC_PAYOUT_THRESHOLD_ZAT=100000000
ZEC_REQUIRED_CONFIRMATIONS=100
ZEC_MAXIMUM_PAYOUT_OUTPUTS=50
ZEC_MAXIMUM_NETWORK_FEE_ZAT=1000000
ZEC_MAXIMUM_NETWORK_FEE_BPS=100
ZEC_POLICY_VERSION=1
# Discovered together with ZCASH_SIGNER_ACCOUNT during wallet-bootstrap.
ZCASH_SIGNER_ACCOUNT_INDEX=BOOTSTRAP_DISCOVERY_REQUIRED

# TLS files must be public-trust certificates for direct ASIC TLS. The portal
# is Cloudflare-only: nginx also requires Authenticated Origin Pulls on every
# HTTPS request, while Full (strict) still requires valid origin certificates.
CLOUDFLARE_ORIGIN_PULL_CA=/etc/wcash-pool/tls/cloudflare-origin-pull-ca.pem
APEX_TLS_CERT=/etc/letsencrypt/live/zecwec.com/fullchain.pem
APEX_TLS_KEY=/etc/letsencrypt/live/zecwec.com/privkey.pem
PORTAL_TLS_CERT=/etc/letsencrypt/live/testnet.zecwec.com/fullchain.pem
PORTAL_TLS_KEY=/etc/letsencrypt/live/testnet.zecwec.com/privkey.pem
MINING_TLS_CERT=/etc/letsencrypt/live/testnet-mine.zecwec.com/fullchain.pem
MINING_TLS_KEY=/etc/letsencrypt/live/testnet-mine.zecwec.com/privkey.pem

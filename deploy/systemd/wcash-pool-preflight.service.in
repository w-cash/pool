[Unit]
Description=Validate ZecWec Testnet pool without opening miner or portal listeners
Documentation=file://@WCASH_RELEASE_ROOT@/deployment/docs/zecwec-testnet-deployment.md
Requires=postgresql.service wcash-pool-migrate.service wcash-pool-backend.service zecwec-zallet.service wcash-pool-wallet-init.service @WCASH_LIGHTWALLETD_UNIT@
BindsTo=wcash-pool-backend.service zecwec-zallet.service @WCASH_LIGHTWALLETD_UNIT@
After=postgresql.service wcash-pool-migrate.service wcash-pool-backend.service zecwec-zallet.service wcash-pool-wallet-init.service @WCASH_LIGHTWALLETD_UNIT@
ConditionFileIsExecutable=@WCASH_RELEASE_ROOT@/wcash-poold
ConditionPathExists=/etc/wcash-pool/pool.preflight.toml

[Service]
Type=oneshot
User=wcash-pool
Group=wcash-pool
SupplementaryGroups=wcash-pool-socket
UMask=0077
Environment=ZECWEC_RELEASE_PATH=@WCASH_RELEASE_ROOT@
Environment=ZEC_AUTHORITY_CONFIG=/run/credentials/wcash-pool-preflight.service/zec-authority-config
Environment=ZEC_AUTHORITY_RESULT=/run/credentials/wcash-pool-preflight.service/zec-initial-zero-result
Environment=ZEC_AUTHORITY_ATTESTATION=/run/credentials/wcash-pool-preflight.service/zec-initial-zero-attestation
LoadCredential=database-url:@DATABASE_RUNTIME_URL_CREDENTIAL@
LoadCredential=portal-token-pepper:@PORTAL_TOKEN_PEPPER_CREDENTIAL@
LoadCredential=portal-totp-key:@PORTAL_TOTP_KEY_CREDENTIAL@
LoadCredential=zallet-config:@ZALLET_CONFIG_FILE@
LoadCredential=zallet-cookie:@ZALLET_STATE_DIR@/.cookie
LoadCredential=wcash-node-cookie:@WCASH_RPC_COOKIE_SOURCE@
LoadCredential=zcash-node-cookie:@ZCASH_VALIDATOR_COOKIE_SOURCE@
LoadCredential=zec-authority-config:/etc/wcash-pool/zec-authority.testnet.toml
LoadCredential=zec-initial-zero-result:@ZCASH_INITIAL_ZERO_RESULT@
LoadCredential=zec-initial-zero-attestation:@ZCASH_INITIAL_ZERO_ATTESTATION@
ExecStartPre=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/verify-release.sh wcash-poold
ExecStartPre=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/verify-release.sh wcash-wallet
ExecStartPre=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/zec-authority-bootstrap.sh verify
ExecStart=@WCASH_RELEASE_ROOT@/wcash-poold config-check --config /etc/wcash-pool/pool.preflight.toml
ExecStart=@WCASH_RELEASE_ROOT@/wcash-poold preflight --config /etc/wcash-pool/pool.preflight.toml
TimeoutStartSec=1800s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Unit]
Description=Watch rotating node RPC credentials for ZecWec Testnet
Documentation=file://@WCASH_RELEASE_ROOT@/deployment/docs/zecwec-testnet-deployment.md
PartOf=zecwec-testnet-pool.target

[Path]
PathChanged=@WCASH_RPC_COOKIE_SOURCE@
PathChanged=@ZCASH_TEMPLATE_COOKIE_SOURCE@
PathChanged=@ZCASH_VALIDATOR_COOKIE_SOURCE@
Unit=zecwec-cookie-refresh.service

[Install]
WantedBy=zecwec-testnet-pool.target

[Unit]
Description=ZecWec Testnet pool health probe
After=wcash-pool.service

[Service]
Type=oneshot
User=root
ExecStart=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/health-check.sh --quiet
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=

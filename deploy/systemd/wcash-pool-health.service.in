[Unit]
Description=ZecWec Testnet pool health probe
After=wcash-pool.service

[Service]
Type=oneshot
User=root
ExecStart=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/health-check.sh --quiet
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/ufw /run/ufw.lock /run/xtables.lock
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SETUID CAP_SETGID
AmbientCapabilities=

[Unit]
Description=Verify isolated hot Wcash and Zcash payout custody before mining
Documentation=file://@WCASH_RELEASE_ROOT@/deployment/docs/zecwec-testnet-deployment.md
PartOf=zecwec-testnet-pool.target
Before=wcash-pool-projector.service wcash-pool.service wcash-payout-worker.service zecwec-zallet-payout.service
Conflicts=zecwec-zallet.service zecwec-zallet-recovery.service wcash-pool-wallet-init.service wcash-pool-zec-authority-bootstrap.service
After=zecwec-zallet.service zecwec-zallet-recovery.service wcash-pool-wallet-init.service wcash-pool-zec-authority-bootstrap.service

[Service]
Type=oneshot
# Keep the successful custody check active for the lifetime of the pool.
# Without this, every dependent service start re-runs the gate after the
# payout wallet has started and the gate incorrectly rejects the healthy
# runtime as an active custody process.
RemainAfterExit=yes
User=root
Group=root
UMask=0077
Environment=ZECWEC_RELEASE_PATH=@WCASH_RELEASE_ROOT@
ExecStartPre=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/verify-release.sh wcash-poold
ExecStartPre=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/verify-release.sh deployment-package
ExecStart=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/verify-offline-custody.sh /etc/wcash-pool/deployment.env
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
# The authority parent is deliberately 0700 and owned by wcash-payout. This
# read-only capability lets the root gate traverse and verify that sealed file
# without granting any write bypass.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH
AmbientCapabilities=

# Managed by the ZecWec Testnet deployment package.
[Unit]
Description=ZecWec WEC/ZEC merged-mining Testnet pool
Documentation=file://@WCASH_RELEASE_ROOT@/deployment/docs/zecwec-testnet-deployment.md
PartOf=zecwec-testnet-pool.target
Requires=postgresql.service wcash-pool-migrate.service wcash-pool-backend.service wcash-pool-projector.service wcash-pool-custody-gate.service
BindsTo=wcash-pool-backend.service wcash-pool-projector.service @WCASH_NODE_UNIT@ @ZCASH_VALIDATOR_UNIT@
After=network-online.target postgresql.service wcash-pool-migrate.service wcash-pool-backend.service wcash-pool-projector.service wcash-pool-custody-gate.service zecwec-zallet.service zecwec-zallet-recovery.service wcash-pool-wallet-init.service wcash-pool-zec-authority-bootstrap.service @WCASH_NODE_UNIT@ @ZCASH_VALIDATOR_UNIT@
Wants=network-online.target
Conflicts=zecwec-zallet.service zecwec-zallet-recovery.service wcash-pool-wallet-init.service wcash-pool-zec-authority-bootstrap.service
ConditionFileIsExecutable=@WCASH_RELEASE_ROOT@/wcash-poold
ConditionPathExists=/etc/wcash-pool/pool.runtime.toml

[Service]
Type=simple
User=wcash-pool
Group=wcash-pool
SupplementaryGroups=wcash-pool-socket
UMask=0077
Environment=ZECWEC_RELEASE_PATH=@WCASH_RELEASE_ROOT@
Environment=ZEC_AUTHORITY_CONFIG=/etc/wcash-pool/zec-authority.testnet.toml
Environment=ZEC_AUTHORITY_RESULT=/var/lib/zecwec-custody/zec-collector-initial-zero.json
Environment=ZEC_AUTHORITY_ATTESTATION=/var/lib/zecwec-custody/zec-collector-initial-zero.attestation
LoadCredential=database-url:@DATABASE_RUNTIME_URL_CREDENTIAL@
LoadCredential=portal-token-pepper:@PORTAL_TOKEN_PEPPER_CREDENTIAL@
LoadCredential=portal-totp-key:@PORTAL_TOTP_KEY_CREDENTIAL@
LoadCredential=wcash-node-cookie:@WCASH_RPC_COOKIE_SOURCE@
LoadCredential=zcash-node-cookie:@ZCASH_VALIDATOR_COOKIE_SOURCE@
ExecStartPre=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/verify-release.sh wcash-poold
ExecStartPre=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/verify-release.sh wcash-wallet
ExecStartPre=+@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/zec-authority-bootstrap.sh verify-sealed
ExecStart=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/pool-entrypoint.sh serve
Restart=on-failure
RestartSec=5s
TimeoutStartSec=1800s
TimeoutStopSec=1920s
KillMode=mixed
StateDirectory=wcash-pool
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
InaccessiblePaths=-@WEC_SEED_FILE@ -@PAYOUT_STATE_DIR@ -@ZALLET_CONFIG_FILE@ -@ZALLET_PAYOUT_CONFIG_FILE@ -@ZALLET_STATE_DIR@ -@ZALLET_RECOVERY_CONFIG_FILE@ -@ZALLET_RECOVERY_STATE_DIR@ -@ZALLET_ENCRYPTION_IDENTITY_CREDENTIAL@
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=zecwec-testnet-pool.target

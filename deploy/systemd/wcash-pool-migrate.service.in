[Unit]
Description=Apply ZecWec Testnet pool database migrations
Documentation=file://@WCASH_RELEASE_ROOT@/deployment/docs/zecwec-testnet-deployment.md
Requires=postgresql.service
After=postgresql.service
ConditionPathIsExecutable=@WCASH_RELEASE_ROOT@/wcash-poold
ConditionPathExists=/etc/wcash-pool/pool.migrate.toml

[Service]
Type=oneshot
User=wcash-pool
Group=wcash-pool
UMask=0077
Environment=ZECWEC_RELEASE_PATH=@WCASH_RELEASE_ROOT@
LoadCredential=database-url:@DATABASE_MIGRATOR_URL_CREDENTIAL@
LoadCredential=portal-token-pepper:@PORTAL_TOKEN_PEPPER_CREDENTIAL@
LoadCredential=portal-totp-key:@PORTAL_TOTP_KEY_CREDENTIAL@
ExecStartPre=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/verify-release.sh wcash-poold
ExecStartPre=@WCASH_RELEASE_ROOT@/wcash-poold config-check --config /etc/wcash-pool/pool.migrate.toml
ExecStart=@WCASH_RELEASE_ROOT@/wcash-poold migrate --config /etc/wcash-pool/pool.migrate.toml
ExecStartPost=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/grant-runtime.sh /run/credentials/wcash-pool-migrate.service/database-url @POSTGRES_RUNTIME_ROLE@
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Unit]
Description=Apply ZecWec Testnet pool database migrations
Documentation=file://@WCASH_RELEASE_ROOT@/deployment/docs/zecwec-testnet-deployment.md
Requires=postgresql.service
After=postgresql.service
ConditionFileIsExecutable=@WCASH_RELEASE_ROOT@/wcash-poold
ConditionPathExists=/etc/wcash-pool/pool.migrate.toml

[Service]
Type=oneshot
User=wcash-pool-migrate
Group=wcash-pool-migrate
UMask=0077
Environment=ZECWEC_RELEASE_PATH=@WCASH_RELEASE_ROOT@
LoadCredential=database-url:@DATABASE_MIGRATOR_URL_CREDENTIAL@
ExecStartPre=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/verify-release.sh wcash-poold
ExecStart=@WCASH_RELEASE_ROOT@/wcash-poold migrate --config /etc/wcash-pool/pool.migrate.toml
ExecStartPost=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/grant-runtime.sh /run/credentials/wcash-pool-migrate.service/database-url @POSTGRES_MIGRATOR_ROLE@ @POSTGRES_RUNTIME_ROLE@ @POSTGRES_PROJECTOR_ROLE@ @POSTGRES_PAYOUT_ROLE@
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
InaccessiblePaths=-@WEC_SEED_FILE@ -@PAYOUT_STATE_DIR@ -@ZALLET_CONFIG_FILE@ -@ZALLET_PAYOUT_CONFIG_FILE@ -@ZALLET_STATE_DIR@ -@ZALLET_RECOVERY_CONFIG_FILE@ -@ZALLET_RECOVERY_STATE_DIR@ -@ZALLET_ENCRYPTION_IDENTITY_CREDENTIAL@ -@PORTAL_TOKEN_PEPPER_CREDENTIAL@ -@PORTAL_TOTP_KEY_CREDENTIAL@
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SocketBindDeny=any
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

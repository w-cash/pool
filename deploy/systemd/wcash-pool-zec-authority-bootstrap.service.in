[Unit]
Description=Seal the initial-zero Zcash Testnet collector authority
Documentation=file://@WCASH_RELEASE_ROOT@/deployment/docs/zecwec-testnet-deployment.md
Requires=zecwec-zallet.service @ZCASH_VALIDATOR_UNIT@
After=zecwec-zallet.service @ZCASH_VALIDATOR_UNIT@
Before=wcash-pool-backend-init.service
ConditionFileIsExecutable=@WCASH_RELEASE_ROOT@/wcash-poold
ConditionPathExists=/etc/wcash-pool/zec-authority.testnet.toml

[Service]
Type=oneshot
User=wcash-pool-backend
Group=wcash-pool-socket
UMask=0077
Environment=ZECWEC_RELEASE_PATH=@WCASH_RELEASE_ROOT@
Environment=ZEC_AUTHORITY_CONFIG=/run/credentials/wcash-pool-zec-authority-bootstrap.service/zec-authority-config
Environment=ZEC_AUTHORITY_RESULT=@ZCASH_INITIAL_ZERO_RESULT@
Environment=ZEC_AUTHORITY_ATTESTATION=@ZCASH_INITIAL_ZERO_ATTESTATION@
Environment=BACKEND_AUTHORITY=@BACKEND_STATE_DIR@/backend-authority-protocol-v2.json
LoadCredential=zallet-cookie:@ZALLET_STATE_DIR@/.cookie
LoadCredential=zcash-node-cookie:@ZCASH_VALIDATOR_COOKIE_SOURCE@
LoadCredential=zec-authority-config:/etc/wcash-pool/zec-authority.testnet.toml
ExecStartPre=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/verify-release.sh wcash-poold
ExecStart=@WCASH_RELEASE_ROOT@/deployment/scripts/deploy/zec-authority-bootstrap.sh reconcile
TimeoutStartSec=300s
StateDirectory=wcash-pool-backend
StateDirectoryMode=0700
RuntimeDirectory=wcash-pool-zec-authority-bootstrap
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

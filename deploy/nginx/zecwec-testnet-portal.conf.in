upstream zecwec_testnet_portal {
    server @PORTAL_LISTEN@;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name @APEX_HOST@ @PORTAL_HOST@;
    return 301 https://@PORTAL_HOST@$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @APEX_HOST@;

    ssl_certificate @APEX_TLS_CERT@;
    ssl_certificate_key @APEX_TLS_KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ZecWecApex:2m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    return 302 https://@PORTAL_HOST@$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @PORTAL_HOST@;

    ssl_certificate @PORTAL_TLS_CERT@;
    ssl_certificate_key @PORTAL_TLS_KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ZecWecPortal:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 16k;
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://zecwec_testnet_portal;
    }

    location = /healthz {
        access_log off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://zecwec_testnet_portal;
    }
}

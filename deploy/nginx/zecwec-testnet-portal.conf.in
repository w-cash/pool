# The key is authoritative only because both HTTPS virtual hosts require
# Cloudflare Authenticated Origin Pulls before evaluating these zones.
limit_req_zone $http_cf_connecting_ip zone=zecwec_portal_requests:10m rate=20r/s;

# An empty key is not accounted by limit_req. Only methods which launch an
# Argon2 password/token operation consume the stricter credential budget.
map "$request_method:$uri" $zecwec_credential_client {
    default "";
    "POST:/api/v1/auth/register" $http_cf_connecting_ip;
    "POST:/api/v1/auth/login" $http_cf_connecting_ip;
    "POST:/api/v1/workers" $http_cf_connecting_ip;
    ~^PUT:/api/v1/settings/payouts/[^/]+$ $http_cf_connecting_ip;
    "POST:/api/v1/security/totp/begin" $http_cf_connecting_ip;
}
limit_req_zone $zecwec_credential_client zone=zecwec_portal_credentials:10m rate=6r/m;

upstream zecwec_testnet_portal {
    server @PORTAL_LISTEN@;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name @APEX_HOST@ @PORTAL_HOST@;
    # The mining hostname reveals the origin IP. Plain HTTP is therefore never
    # an origin path; Cloudflare redirects clients at the edge.
    return 444;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name @APEX_HOST@;

    ssl_certificate @APEX_TLS_CERT@;
    ssl_certificate_key @APEX_TLS_KEY@;
    ssl_client_certificate @CLOUDFLARE_ORIGIN_PULL_CA@;
    ssl_verify_client on;
    ssl_verify_depth 1;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ZecWecApex:2m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;
    if ($http_cf_connecting_ip = "") { return 403; }

    return 302 https://@PORTAL_HOST@$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name @PORTAL_HOST@;

    ssl_certificate @PORTAL_TLS_CERT@;
    ssl_certificate_key @PORTAL_TLS_KEY@;
    ssl_client_certificate @CLOUDFLARE_ORIGIN_PULL_CA@;
    ssl_verify_client on;
    ssl_verify_depth 1;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ZecWecPortal:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    if ($http_cf_connecting_ip = "") { return 403; }

    client_max_body_size 16k;
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
    limit_req_status 429;

    location / {
        limit_req zone=zecwec_portal_requests burst=40 nodelay;
        limit_req zone=zecwec_portal_credentials burst=4 nodelay;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Authenticated Origin Pulls makes Cloudflare's overwritten client-IP
        # header authoritative; arbitrary Internet clients never reach here.
        proxy_set_header X-Real-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://zecwec_testnet_portal;
    }

    location = /healthz {
        access_log off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://zecwec_testnet_portal;
    }
}

+/// Minimum database pool capacity for the four long-lived sync handles and RPC work.
+const MIN_WALLET_POOL_SIZE: usize = 8;
+
+/// Bounds RPC and command waits if every non-sync database handle is occupied.
+const WALLET_POOL_WAIT_TIMEOUT: Duration = Duration::from_secs(30);
+
+fn wallet_pool_config() -> deadpool::managed::PoolConfig {
+    wallet_pool_config_from(deadpool::managed::PoolConfig::default())
+}
+
+fn wallet_pool_config_from(
+    mut config: deadpool::managed::PoolConfig,
+) -> deadpool::managed::PoolConfig {
+    config.max_size = config.max_size.max(MIN_WALLET_POOL_SIZE);
+    config.timeouts.wait = Some(WALLET_POOL_WAIT_TIMEOUT);
+    config
+}
+
+#[cfg(test)]
+mod pool_config_tests {
+    use super::*;
+
+    #[test]
+    fn low_core_defaults_leave_capacity_for_rpc_work() {
+        for default_size in [2, 4] {
+            let config = wallet_pool_config_from(deadpool::managed::PoolConfig::new(default_size));
+            assert_eq!(config.max_size, MIN_WALLET_POOL_SIZE);
+            assert_eq!(config.timeouts.wait, Some(WALLET_POOL_WAIT_TIMEOUT));
+        }
+    }
+
+    #[test]
+    fn larger_defaults_are_preserved() {
+        let default_size = MIN_WALLET_POOL_SIZE * 2;
+        let config = wallet_pool_config_from(deadpool::managed::PoolConfig::new(default_size));
+        assert_eq!(config.max_size, default_size);
+        assert_eq!(config.timeouts.wait, Some(WALLET_POOL_WAIT_TIMEOUT));
+    }
+
+    #[test]
+    fn configured_timeout_has_a_runtime() {
+        let temporary = tempfile::tempdir().unwrap();
+        let result = pool(
+            temporary.path().join("wallet.db"),
+            Network::Consensus(zcash_protocol::consensus::Network::TestNetwork),
+        );
+        assert!(result.is_ok());
+    }
+}

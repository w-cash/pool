+fn emit_db_dump_path(out_path: &Path, db_dump_binary: &Path) -> Result<(), String> {
+    // Cargo places OUT_DIR below `<profile>/build/<unit>/out`, while the
+    // executable is written directly below `<profile>`. Store that stable,
+    // executable-relative suffix rather than an absolute build-host path.
+    let profile_dir = out_path
+        .ancestors()
+        .nth(3)
+        .ok_or_else(|| format!("Unexpected OUT_DIR layout: {}", out_path.display()))?;
+    let relative_path = db_dump_binary.strip_prefix(profile_dir).map_err(|_| {
+        format!(
+            "db_dump escaped Cargo profile directory: {}",
+            db_dump_binary.display()
+        )
+    })?;
+    if relative_path.is_absolute() {
+        return Err(format!(
+            "db_dump path was not made relative: {}",
+            relative_path.display()
+        ));
+    }
+
+    println!("cargo:rustc-env=DB_DUMP_PATH={}", relative_path.display());
+    Ok(())
+}
